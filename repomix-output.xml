// lastAnalysisAt   DateTime?   @map("last_analysis_at")
// lastAnalysisRunId String?    @map("last_analysis_run_id")
// diagramVersions  DiagramVersion[]
// lock             ThreatModelLock?
// analysisRuns     AnalysisRun[]
```

