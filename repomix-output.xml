      - pattern: (StringBuilder $B).$ANY(...,(string $X),...)
        from: $X
        to: $B
    pattern-sinks:
      - patterns:
          - pattern-either:
              - patterns:
                  - pattern: |
                      new $PATTERN($CMD,...)
                  - focus-metavariable: $CMD
              - patterns:
                  - pattern: |
                      $CMD.$PATTERN = $VALUE;
                  - focus-metavariable: $VALUE
