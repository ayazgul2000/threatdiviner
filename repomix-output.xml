  const stateConfig = {
    open: { bg: 'bg-green-50', border: 'border-green-300', icon: 'text-green-600', label: 'text-green-700' },
    merged: { bg: 'bg-purple-50', border: 'border-purple-300', icon: 'text-purple-600', label: 'text-purple-700' },
    closed: { bg: 'bg-gray-50', border: 'border-gray-300', icon: 'text-gray-500', label: 'text-gray-600' },
    blocked: { bg: 'bg-rose-50', border: 'border-rose-300', icon: 'text-rose-600', label: 'text-rose-700' },
  };

  const checksColors = {
    success: 'text-emerald-500',
    failure: 'text-rose-500',
    pending: 'text-amber-500',
  };

  const cfg = stateConfig[state];

  return (
    <div className={`w-36 p-2.5 rounded-lg ${cfg.bg} border ${cfg.border} shadow-sm`}>
      <div className="flex items-center gap-1.5 mb-1.5">
        <GitPullRequest className={`w-4 h-4 ${cfg.icon}`} strokeWidth={2.5} />
        <span className={`text-xs font-bold ${cfg.label}`}>#{number}</span>
        {checksState && (
          <CheckCircle2 className={`w-3.5 h-3.5 ml-auto ${checksColors[checksState]}`} />
        )}
      </div>
      <p className="text-[10px] text-gray-700 truncate mb-1.5" title={title}>{title}</p>
      <div className="flex items-center gap-1 text-[10px] text-gray-500">
        <User className="w-3 h-3" />
        <span className="truncate">{author}</span>
      </div>
    </div>
  );
}

// ============ COMMIT CARD ============
interface CommitCardProps {
  sha: string;
  message: string;
  author: string;
  time: string;
}

function CommitCard({ sha, message, author, time }: CommitCardProps) {
  return (
    <div className="w-36 p-2.5 rounded-lg bg-white border border-gray-200 shadow-sm">
      <div className="flex items-center gap-1.5 mb-1.5">
        <CircleDot className="w-4 h-4 text-gray-500" strokeWidth={2.5} />
        <code className="text-[10px] font-mono font-bold text-indigo-600">{sha.slice(0, 7)}</code>
      </div>
      <p className="text-[10px] text-gray-700 truncate mb-1.5" title={message}>{message}</p>
      <div className="flex items-center justify-between text-[10px] text-gray-500">
        <span className="truncate">{author}</span>
        <span className="flex items-center gap-0.5 text-gray-400">
          <Clock className="w-3 h-3" />
          {time}
        </span>
      </div>
    </div>
  );
}

// ============ BUILD CARD ============
interface BuildCardProps {
  number: number;
  status: 'success' | 'failure' | 'running' | 'pending';
  duration?: string;
}

function BuildCard({ number, status, duration }: BuildCardProps) {
  const statusConfig = {
    success: { bg: 'bg-emerald-50', border: 'border-emerald-300', icon: CheckCircle2, iconColor: 'text-emerald-600', label: 'Passed', labelColor: 'text-emerald-700' },
    failure: { bg: 'bg-rose-50', border: 'border-rose-300', icon: XCircle, iconColor: 'text-rose-600', label: 'Failed', labelColor: 'text-rose-700' },
    running: { bg: 'bg-blue-50', border: 'border-blue-300', icon: Loader2, iconColor: 'text-blue-600', label: 'Running', labelColor: 'text-blue-700' },
    pending: { bg: 'bg-gray-50', border: 'border-gray-300', icon: Clock, iconColor: 'text-gray-500', label: 'Pending', labelColor: 'text-gray-600' },
  };

  const cfg = statusConfig[status];
  const Icon = cfg.icon;

  return (
    <div className={`w-24 p-2.5 rounded-lg ${cfg.bg} border ${cfg.border} shadow-sm`}>
      <div className="flex items-center gap-1.5 mb-1.5">
        <Package className="w-3.5 h-3.5 text-gray-500" strokeWidth={2} />
        <span className="text-[10px] font-bold text-gray-700">#{number}</span>
      </div>
      <div className="flex items-center gap-1">
        <Icon className={`w-4 h-4 ${cfg.iconColor} ${status === 'running' ? 'animate-spin' : ''}`} strokeWidth={2.5} />
        <span className={`text-[10px] font-semibold ${cfg.labelColor}`}>{cfg.label}</span>
      </div>
      {duration && (
        <div className="mt-1 text-[9px] text-gray-400">{duration}</div>
      )}
    </div>
  );
}

// ============ ENVIRONMENT CARD ============
interface EnvCardProps {
  name: string;
  type: 'dev' | 'staging' | 'prod';
  status: 'deployed' | 'deploying' | 'failed' | 'pending';
  version?: string;
  healthScore?: number | null;
}

function EnvCard({ name, type, status, version, healthScore }: EnvCardProps) {
  const typeConfig = {
    dev: { bg: 'bg-sky-50', border: 'border-sky-300', badge: 'bg-sky-100 text-sky-700' },
    staging: { bg: 'bg-amber-50', border: 'border-amber-300', badge: 'bg-amber-100 text-amber-700' },
    prod: { bg: 'bg-emerald-50', border: 'border-emerald-300', badge: 'bg-emerald-100 text-emerald-700' },
  };

  const statusConfig = {
    deployed: { icon: CheckCircle2, color: 'text-emerald-500' },
    deploying: { icon: Loader2, color: 'text-blue-500' },
    failed: { icon: XCircle, color: 'text-rose-500' },
    pending: { icon: Clock, color: 'text-gray-400' },
  };

  const typeCfg = typeConfig[type];
  const statusCfg = statusConfig[status];
  const StatusIcon = statusCfg.icon;

  return (
    <div className={`w-20 p-2 rounded-lg ${typeCfg.bg} border ${typeCfg.border} shadow-sm`}>
      <div className="flex items-center justify-between mb-1">
        <span className={`text-[9px] font-bold px-1.5 py-0.5 rounded ${typeCfg.badge} uppercase`}>
          {type}
        </span>
        <StatusIcon className={`w-3.5 h-3.5 ${statusCfg.color} ${status === 'deploying' ? 'animate-spin' : ''}`} strokeWidth={2.5} />
      </div>
      {version && (
        <div className="text-[9px] font-mono text-gray-600 truncate">{version}</div>
      )}
      {healthScore !== undefined && healthScore !== null && (
        <div className={`text-[9px] font-semibold mt-0.5 ${healthScore >= 80 ? 'text-emerald-600' : healthScore >= 50 ? 'text-amber-600' : 'text-rose-600'}`}>
          {healthScore}%
        </div>
      )}
    </div>
  );
}

// ============ DEPLOYMENT ROW ============
interface DeploymentRowProps {
  envs: Array<{ name: string; type: 'dev' | 'staging' | 'prod'; status: 'deployed' | 'deploying' | 'failed' | 'pending'; version?: string; healthScore?: number | null }>;
}

function DeploymentRow({ envs }: DeploymentRowProps) {
  return (
    <div className="flex items-center gap-1">
      {envs.map((env, idx) => (
        <div key={idx} className="flex items-center">
          <EnvCard {...env} />
          {idx < envs.length - 1 && (
            <div className="mx-0.5 text-gray-300">→</div>
          )}
        </div>
      ))}
    </div>
  );
}

// ============ PLACEHOLDER NODE ============
function PlaceholderNode({ label, height = 'h-[76px]' }: { label: string; height?: string }) {
  return (
    <div className={`${height} rounded-lg border-2 border-dashed border-gray-200 flex items-center justify-center`}>
      <span className="text-xs text-gray-400">{label}</span>
    </div>
  );
}

