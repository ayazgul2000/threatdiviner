        rule:
          r_id: 9970
          rv_id: 1263244
          rule_id: wdU8GB
          version_id: LjTkgJy
          url: >-
            https://semgrep.dev/playground/r/LjTkgJy/javascript.sequelize.security.audit.sequelize-weak-tls-version.sequelize-weak-tls-version
          origin: community
    languages:
      - javascript
      - typescript
    severity: WARNING
