  completedAt    DateTime?  @map("completed_at")
  duration       Int?
  errorMessage   String?    @map("error_message")
  createdAt      DateTime   @default(now()) @map("created_at")
  projectId      String?    @map("project_id")

  // CLI/Pipeline trigger metadata
  cliTriggered         Boolean   @default(false) @map("cli_triggered")
  cliWriteBackConfig   String[]  @default([]) @map("cli_write_back_config") // Write-back options enabled for this scan
  cliFailOnSeverity    String?   @map("cli_fail_on_severity") // Pipeline gate: fail on this severity
  cliFailOnCount       Int?      @map("cli_fail_on_count") // Pipeline gate: fail if count exceeds

  // Triage settings for this scan
  // scanType: standard (normal scan), deep-analysis (comprehensive repo analysis)
  scanType             String    @default("standard") @map("scan_type")
  // triageMode used: snippet, full-file, or none
  triageMode           String    @default("snippet") @map("triage_mode")
  // Deep analysis options (JSON): { similarVulns, callChain, fixPropagation, securityTests, architecture, attackChain }
  deepAnalysisOptions  Json?     @map("deep_analysis_options")
  triageStartedAt      DateTime? @map("triage_started_at")
  triageCompletedAt    DateTime? @map("triage_completed_at")
  findingsTriaged      Int?      @map("findings_triaged")
  fixesGenerated       Int?      @map("fixes_generated")

  findings       Finding[]
  project        Project?   @relation(fields: [projectId], references: [id])
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([repositoryId])
  @@index([projectId])
  @@index([status])
  @@index([cliTriggered])
  @@map("scans")
}

