  useEffect(() => {
    if (scanId) {
      loadData();
    }
  }, [scanId]);

  const loadData = async () => {
    setIsLoading(true);
    try {
      const [scanData, findingsData] = await Promise.all([
        fetchScan(scanId),
        fetchScanFindings(scanId),
      ]);
      setScan(scanData);
      setFindings({ ...findingsData, scanId });
      
      // Fetch repo info if we have repositoryId
