<file path="apps/api/src/scanners/sast/semgrep/rules/registry/default/terraform_aws_security_aws-ecr-repository-wildcard-principal_aws-ecr-repository-wildcard-principal.yaml">
rules:
  - id: >-
      terraform.aws.security.aws-ecr-repository-wildcard-principal.aws-ecr-repository-wildcard-principal
    patterns:
      - pattern-inside: |
          resource "aws_ecr_repository_policy" $ANYTHING {
            ...
          }
      - pattern-either:
          - patterns:
              - pattern: policy = "$JSONPOLICY"
              - metavariable-pattern:
                  metavariable: $JSONPOLICY
                  language: json
                  patterns:
                    - pattern-not-inside: |
                        {..., "Effect": "Deny", ...}
                    - pattern-either:
                        - pattern: |
                            {..., "Principal": "*", ...}
                        - pattern: |
                            {..., "Principal": [..., "*", ...], ...}
                        - pattern: |
                            {..., "Principal": { "AWS": "*" }, ...}
                        - pattern: |
                            {..., "Principal": { "AWS": [..., "*", ...] }, ...}
          - patterns:
              - pattern-inside: policy = jsonencode(...)
              - pattern-not-inside: |
                  {..., Effect = "Deny", ...}
              - pattern-either:
                  - pattern: |
                      {..., Principal = "*", ...}
                  - pattern: |
                      {..., Principal = [..., "*", ...], ...}
                  - pattern: |
                      {..., Principal = { AWS = "*" }, ...}
                  - pattern: |
                      {..., Principal = { AWS = [..., "*", ...] }, ...}
    message: >-
      Detected wildcard access granted in your ECR repository policy principal.
      This grants access to all users, including anonymous users (public
      access). Instead, limit principals, actions and resources to what you need
      according to least privilege.
    metadata:
      category: security
      technology:
