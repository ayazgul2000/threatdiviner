describe('SchedulerService', () => {
  let service: SchedulerService;

  const mockPrismaService = {
    scanConfig: {
      findMany: jest.fn(),
      findFirst: jest.fn(),
      update: jest.fn(),
    },
    scan: {
      create: jest.fn(),
      findFirst: jest.fn(),
      findMany: jest.fn(),
