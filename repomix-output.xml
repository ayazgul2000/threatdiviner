<file path="apps/api/src/scanners/sast/semgrep/rules/registry/security-audit/python_sqlalchemy_security_sqlalchemy-sql-injection_sqlalchemy-sql-injection.yaml">
rules:
  - id: >-
      python.sqlalchemy.security.sqlalchemy-sql-injection.sqlalchemy-sql-injection
    patterns:
      - pattern-either:
          - pattern: |
              def $FUNC(...,$VAR,...):
                ...
                $SESSION.query(...).$SQLFUNC("...".$FORMATFUNC(...,$VAR,...))
          - pattern: |
              def $FUNC(...,$VAR,...):
                ...
                $SESSION.query.join(...).$SQLFUNC("...".$FORMATFUNC(...,$VAR,...))
          - pattern: |
              def $FUNC(...,$VAR,...):
                ...
                $SESSION.query.$SQLFUNC("...".$FORMATFUNC(...,$VAR,...))
          - pattern: |
              def $FUNC(...,$VAR,...):
                ...
                query.$SQLFUNC("...".$FORMATFUNC(...,$VAR,...))
      - metavariable-regex:
          metavariable: $SQLFUNC
          regex: (group_by|order_by|distinct|having|filter)
      - metavariable-regex:
          metavariable: $FORMATFUNC
          regex: (?!bindparams)
    message: >-
      Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause
      sql injections if the developer inputs raw SQL into the before-mentioned
      clauses. This pattern captures relevant cases in which the developer
      inputs raw SQL into the distinct, having, group_by, order_by or filter
      clauses and injects user-input into the raw SQL with any function besides
      "bindparams". Use bindParams to securely bind user-input to SQL
      statements.
    fix-regex:
      regex: format
      replacement: bindparams
    languages:
      - python
    severity: WARNING
    metadata:
      cwe:
        - >-
          CWE-89: Improper Neutralization of Special Elements used in an SQL
          Command ('SQL Injection')
      category: security
      technology:
        - sqlalchemy
      owasp:
        - A01:2017 - Injection
        - A03:2021 - Injection
        - A05:2025 - Injection
      references:
        - https://owasp.org/Top10/A03_2021-Injection
