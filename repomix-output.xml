    mode: taint
    pattern-sinks:
      - pattern: |
          sqlalchemy.text(...)
    pattern-sources:
      - patterns:
          - pattern: |
              $X + $Y
          - metavariable-type:
              metavariable: $X
              type: string
      - patterns:
          - pattern: |
              $X + $Y
          - metavariable-type:
              metavariable: $Y
              type: string
      - patterns:
          - pattern: |
              f"..."
      - patterns:
          - pattern: |
              $X.format(...)
          - metavariable-type:
