#!/bin/bash

# ThreatDiviner Functional Test Suite
# Tests every entity and operation per THREATDIVINER-DEFINITIONS.md

set -e

API_URL="${API_URL:-http://localhost:3001}"
DASHBOARD_URL="${DASHBOARD_URL:-http://localhost:3000}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

