            ...
            var $TEMPLATE = "..."
            ...
            $W.Write([]byte(fmt.$PRINTF($TEMPLATE, ...)), ...)
            ...
          }
      - pattern-either:
          - pattern: |
              $PARAMS = r.URL.Query()
              ...
              $DATA, $ERR := $PARAMS[...]
              ...
              $INTERM = $ANYTHING(..., $DATA, ...)
              ...
