  async rejectSuggestion(
    @Param('id') id: string,
    @Body() dto: RejectSuggestionDto,
    @Request() req: RequestWithUser,
  ) {
    const suggestion = await this.suggestionsService.rejectSuggestion(id, dto, req.platformAdmin.id);
