              </div>
              <pre className="text-sm text-rose-600 whitespace-pre-wrap">{scan.errorMessage}</pre>
            </div>
          )}
        </div>

        {/* Right Column - Findings */}
        <div>
          <FindingsSummary scan={scan} scanId={scanId} />
        </div>
      </div>
    </div>
  );
}
