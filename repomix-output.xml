          version_id: yeT0nDq
          url: >-
            https://semgrep.dev/playground/r/yeT0nDq/csharp.lang.security.regular-expression-dos.regular-expression-dos-infinite-timeout.regular-expression-dos-infinite-timeout
          origin: community
    message: >-
      Specifying the regex timeout leaves the system vulnerable to a regex-based
      Denial of Service (DoS) attack. Consider setting the timeout to a short
      amount of time like 2 or 3 seconds. If you are sure you need an infinite
      timeout, double check that your context meets the conditions outlined in
      the "Notes to Callers" section at the bottom of this page:
      https://docs.microsoft.com/en-us/dotnet/api/system.text.regularexpressions.regex.-ctor?view=net-6.0
    patterns:
      - pattern-inside: |
          using System.Text.RegularExpressions;
          ...
      - pattern-either:
          - pattern: new Regex(..., TimeSpan.InfiniteMatchTimeout)
          - patterns:
              - pattern: new Regex(..., TimeSpan.FromSeconds($TIME))
              - metavariable-comparison:
                  metavariable: $TIME
                  comparison: $TIME > 5
          - pattern: new Regex(..., TimeSpan.FromMinutes(...))
          - pattern: new Regex(..., TimeSpan.FromHours(...))
</file>

