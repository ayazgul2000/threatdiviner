      </div>
      ` : ''}

      <div class="cta">
        <a href="${data.dashboardUrl}" class="button">View Dashboard</a>
      </div>
    </div>
  </div>
</body>
</html>
    `,
    text: `
Weekly Security Summary: ${data.tenantName}
${data.periodStart} - ${data.periodEnd}

Summary:
- Total Scans: ${data.totalScans}
