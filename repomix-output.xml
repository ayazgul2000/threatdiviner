          origin: community
    languages:
      - java
    patterns:
      - pattern: |
          new SSLConnectionSocketFactory(...);
      - pattern-not: >
          new SSLConnectionSocketFactory(..., new String[] {"TLSv1.2",
          "TLSv1.3"}, ...);
      - pattern-not: >
          new SSLConnectionSocketFactory(..., new String[] {"TLSv1.3",
          "TLSv1.2"}, ...);
      - pattern-not: |
          new SSLConnectionSocketFactory(..., new String[] {"TLSv1.3"}, ...);
