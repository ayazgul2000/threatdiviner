      python.sqlalchemy.security.audit.avoid-sqlalchemy-text.avoid-sqlalchemy-text
    mode: taint
    pattern-sinks:
      - pattern: |
          sqlalchemy.text(...)
    pattern-sources:
      - patterns:
          - pattern: |
              $X + $Y
          - metavariable-type:
              metavariable: $X
              type: string
      - patterns:
          - pattern: |
              $X + $Y
          - metavariable-type:
              metavariable: $Y
              type: string
