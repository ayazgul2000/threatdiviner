    patterns:
      - pattern-inside: |
          @$APP.route(...)
          def $X(...):
            ...
      - pattern-not-inside: |
          @$APP.route(...)
          def $X(...):
            ...
            if <... werkzeug.urls.url_parse($V) ...>:
              ...
      - pattern-either:
          - pattern: flask.redirect(<... flask.request.$W.get(...) ...>, ...)
          - pattern: flask.redirect(<... flask.request.$W[...] ...>, ...)
          - pattern: flask.redirect(<... flask.request.$W(...) ...>, ...)
          - pattern: flask.redirect(<... flask.request.$W ...>, ...)
          - pattern: |
              $V = flask.request.$W.get(...)
              ...
              flask.redirect(<... $V ...>, ...)
          - pattern: |
              $V = flask.request.$W[...]
              ...
              flask.redirect(<... $V ...>, ...)
          - pattern: |
              $V = flask.request.$W(...)
              ...
              flask.redirect(<... $V ...>, ...)
          - pattern: |
              $V = flask.request.$W
              ...
              flask.redirect(<... $V ...>, ...)
      - pattern-not: flask.redirect(flask.request.path)
      - pattern-not: flask.redirect(flask.request.path + ...)
