      expect(result.updated).toBe(1);
      expect(result.failed).toBe(0);
      expect(mockPrisma.threatModelDataFlow.update).toHaveBeenCalledWith({
        where: { id: 'df1' },
        data: { protocol: 'https', dataType: 'api-requests' },
