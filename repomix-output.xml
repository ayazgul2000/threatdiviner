              - pattern-either:
                  - pattern: $JWT.encode($X, $KEY, ...)
                  - pattern: $JWT.decode($X, $KEY, ...)
                  - pattern: $JWT.decodeRawAll($X, $KEY, ...)
                  - pattern: $JWT.decodeRaw($X, $KEY, ...)
                  - pattern: $JWT.decodeAll($X, $KEY, ...)
