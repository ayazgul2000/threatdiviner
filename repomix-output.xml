        state: pr.merged_at ? 'merged' : pr.state,
        htmlUrl: pr.html_url,
        headSha: pr.head.sha,
        baseBranch: pr.base.ref,
        headBranch: pr.head.ref,
        author: pr.user?.login || 'unknown',
        mergedAt: pr.merged_at || null,
