    image: postgres:16-alpine
    container_name: td-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: threatdiviner_dev
      POSTGRES_DB: threatdiviner
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
