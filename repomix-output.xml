            https://semgrep.dev/playground/r/kbTYRwl/yaml.github-actions.security.workflow-run-target-code-checkout.workflow-run-target-code-checkout
          origin: community
    patterns:
      - pattern-inside: |
          on:
            ...
            workflow_run: ...
            ...
          ...
