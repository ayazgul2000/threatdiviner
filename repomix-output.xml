      shortlink: https://sg.run/dvwX
      semgrep.dev:
        rule:
          r_id: 71534
          rv_id: 1262610
          rule_id: NbUy12
          version_id: K3TKk7E
          url: >-
            https://semgrep.dev/playground/r/K3TKk7E/clojure.lang.security.use-of-sha1.use-of-sha1
          origin: community
    patterns:
      - pattern-either:
          - pattern: (MessageDigest/getInstance $ALGO)
          - pattern: (java.security.MessageDigest/getInstance $ALGO)
