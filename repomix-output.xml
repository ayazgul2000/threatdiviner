          - pattern: $JWT.decodeAll($X, "...", ...)
          - pattern: $JWT.validate($X, "...", ...)
          - pattern: $JWT.isValid($X, "...", ...)
          - pattern: $JWT.decodeJson($X, "...", ...)
          - pattern: $JWT.decodeJsonAll($X, "...", ...)
