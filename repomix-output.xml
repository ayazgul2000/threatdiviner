              - pattern-either:
                  - pattern: $QUERY = fmt.Fprintf($F, "$SQLSTR", ...)
                  - pattern: $QUERY = fmt.Sprintf("$SQLSTR", ...)
                  - pattern: $QUERY = fmt.Printf("$SQLSTR", ...)
                  - pattern: $QUERY = $X + ...
              - pattern-either:
                  - pattern-inside: |
                      func $FUNC(...) {
                          ...
                          $OBJ.Query($QUERY, ...)
                          ...
                      }
                  - pattern-inside: |
                      func $FUNC(...) {
                          ...
                          $OBJ.ExecContext($CTX, $QUERY, ...)
                          ...
                      }
                  - pattern-inside: |
                      func $FUNC(...) {
                          ...
                          $OBJ.Exec($QUERY, ...)
                          ...
                      }
                  - pattern-inside: |
                      func $FUNC(...) {
                          ...
